# Copy to .env and fill in. scripts/reset.sh sources .env automatically.
#
# With no key set, Bridge runs on deterministic heuristics end to end -- the
# demo never dies on a missing key. Set one to switch the real reasoning on.

OPENAI_API_KEY=sk-...

# Optional: override the model set in jac.toml
# BYLLM_DEFAULT_MODEL=gpt-4o-mini
